{$DOMAIN:localhost} {
	encode zstd gzip

	# Bỏ dấu # ở 3 dòng dưới nếu không muốn công khai tài liệu API
	# handle /api/docs/* /api/schema/* /api/redoc/* {
	# 	respond 404
	# }

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}
	handle /media/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv/www

		# Các file này phải luôn kiểm tra lại để PWA nhận được bản mới
		@revalidate path /index.html /sw.js /manifest.webmanifest /registerSW.js
		header @revalidate Cache-Control "no-cache"

		# File trong /assets có mã băm trong tên nên lưu lâu được
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}